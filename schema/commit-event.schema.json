{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mphaxise/design-ledger/main/schema/commit-event.schema.json",
  "title": "design-ledger commit event v0.4",
  "type": "object",
  "required": ["record", "schema_version", "id", "observed_at", "repository", "contract_digest", "contract", "source", "changes"],
  "properties": {
    "record": { "const": "design-ledger/commit-event" },
    "schema_version": { "const": "0.4" },
    "id": { "type": "string", "format": "uuid" },
    "observed_at": { "type": "string", "format": "date-time" },
    "repository": { "type": "string" },
    "contract_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "contract": { "$ref": "git-adapter.schema.json" },
    "source": {
      "type": "object",
      "required": ["commit", "parents", "committed_at", "attribution"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "parents": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" } },
        "committed_at": { "type": "string", "format": "date-time" },
        "attribution": {
          "type": "object",
          "required": ["primary_actor", "actors"],
          "properties": {
            "primary_actor": { "type": "string" },
            "actors": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "kind", "display_name", "roles"],
                "properties": {
                  "id": { "type": "string" },
                  "kind": { "enum": ["human", "agent", "service", "git-identity"] },
                  "display_name": { "type": "string" },
                  "roles": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "changes": { "type": "array", "items": { "type": "string" } }
  }
}
